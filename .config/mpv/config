ytdl-format=bestvideo[height<=?720]+bestaudio/best
save-position-on-quit=yes
hwdec=auto-safe
write-filename-in-watch-later-config=yes
save-watch-history=yes

vo=gpu-next
gpu-api=vulkan
video-sync=display-resample

# Cache and demuxer settings
cache=yes
demuxer-max-bytes=5GiB
demuxer-max-back-bytes=5GiB

# Metered-network overrides written by ~/.scripts/save-data (empty when off).
# Must stay after every top-level option it overrides and before the first
# [profile] section, or it would only apply inside that profile.
include="~~/save-data.conf"

[protocol.https]
speed=1.25


