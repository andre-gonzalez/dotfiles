	name = André Gonzalez
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[core]
	editor = nvim
[pull]
	rebase = true
[rebase]
	autoStash = true
[init]
	defaultBranch = main
[alias]
	root = rev-parse --show-toplevel
[pager]
  # Use `delta`.
  log = delta
  show = delta
  diff = delta
[delta]
    side-by-side = true
