# Increase volume
"sh -c 'pactl set-sink-volume @DEFAULT_SINK@ +1000; touch /tmp/dwm_volume_show; ( sleep 2 && rm -f /tmp/dwm_volume_show && kill -44 $(pidof dwmblocks) && kill -46 $(pidof dwmblocks) ) & kill -44 $(pidof dwmblocks) && kill -46 $(pidof dwmblocks)'"
   XF86AudioRaiseVolume

# Decrease volume
"sh -c 'pactl set-sink-volume @DEFAULT_SINK@ -1000; touch /tmp/dwm_volume_show; ( sleep 2 && rm -f /tmp/dwm_volume_show && kill -44 $(pidof dwmblocks) && kill -46 $(pidof dwmblocks) ) & kill -44 $(pidof dwmblocks) && kill -46 $(pidof dwmblocks)'"
   XF86AudioLowerVolume

# Mute volume
"pactl set-sink-mute @DEFAULT_SINK@ toggle; kill -44 $(pidof dwmblocks) && kill -46 $(pidof dwmblocks)"
   XF86AudioMute

# Play and pause audio
# Bluetooth AVRCP sends KEY_PLAYCD/KEY_PAUSECD (XF86AudioPlay/XF86AudioPause),
# not KEY_PLAYPAUSE, so both keysyms need binding.
"playerctl -p playerctld play-pause"
   XF86AudioPlay

"playerctl -p playerctld play-pause"
   XF86AudioPause

# Skip track
 "playerctl -p playerctld next"
   XF86AudioNext

# Earlier track
"playerctl -p playerctld previous"
   XF86AudioPrev
